{
  "expo": {
    "name": "Concert Tracker",
    "slug": "concert-tracker",
    "scheme": "concerttracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pe.edu.utec.concerttracker"
    },
    "android": {
      "package": "pe.edu.utec.concerttracker",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para escanear el código QR de un concierto.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrarte los conciertos de tu ciudad."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c2b7344f-7a2c-4c2d-a0eb-f23c24cd1730"
      }
    },
    "owner": "mafilacrafiwafi",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c2b7344f-7a2c-4c2d-a0eb-f23c24cd1730"
    }
  }
}
